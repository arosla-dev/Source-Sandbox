$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"sandbox"

$Include "$SRCDIR\game\client\client_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;.\hl2;.\sandbox;.\sandbox\vgui;.\gameui;$SRCDIR\game\client\sandbox\gameui;..\statemachine;$SRCDIR\game\shared\multiplayer;.\multiplayer;$SRCDIR\game\shared\sandbox"
		$PreprocessorDefinitions		"$BASE;SWARM_DLL;sandbox_DLL;GAMEUI_EMBEDDED;GAMEUI_EXPORTS"
	}
}

$Project "Client (Sandbox)"
